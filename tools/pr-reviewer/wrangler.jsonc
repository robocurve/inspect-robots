{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inspect-robots-reviewer",
  "account_id": "7f405baff0972dc740a02ee0f700d2c1",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "MODE": "advisory", "ENABLED": "true",
    "REVIEW_PR_LIMITS_JSON": "{\"455\":20000000,\"456\":25000000,\"512\":1069280,\"513\":3930720,\"404\":20000000,\"514\":20000000,\"599\":450000000,\"609\":40000000,\"611\":40000000}",
    "REVIEW_HEAD_LIMITS_JSON": "{\"455-467b9bff8cf4f70d51268f1828171cd377e11262\":7000000,\"456-696fbaa9a00d7c345a81dd179fa10934f51ade89\":25000000,\"599-7ad8142f4d39fc5e837a815d2bbe07b9b1c7f3c3\":20000000,\"599-4ca3781c7616228a173f9d2a49e463eac7d7c5c5\":30000000,\"599-a84303e3d5a074a2353f5b9b51a472484416046e\":30000000,\"599-9423d407f3bcb3463ad90155e548bc3d68269330\":30000000,\"599-30aa26c92a533655c6f13f874a2de9d2ef6e914c\":30000000,\"599-7d306398930abf305a73ce8d339fd20e6c4e0e8e\":30000000,\"599-06f74c335d2b45b70f5e7cafd284df5efa51cd04\":30000000,\"599-e2fc5ef8afb36af442e6b7f71b2e92023c667deb\":30000000,\"599-5a3ddef3cfa0160cc5e80841b44969145ef660b0\":30000000,\"599-c18aff405f773ac0fbbc5e6af213083cb786d936\":30000000,\"599-aee8947912509517a81e5d665d597590112dc2c4\":30000000,\"599-5d64ca616dd649b1c2f46c3367ca808db83c97ca\":30000000,\"599-5d77fff4e80f959c9e5190b9d94a1d8a3eef931d\":60000000,\"599-822f5cb408e23d60ca5f9a70b1003a77b2e16891\":160000000,\"609-1a7e492e52b5b2b7a79d36251a6ecf1d9f96ee55\":20000000,\"611-a7e754eddde6c831bb15ae5f4469686914d7389b\":20000000}",
    "REVIEW_AUTHOR_LIMITS_JSON": "{\"6877537-2026-11\":450000000,\"42904912-2026-11\":60000000}"
  },
  "services": [{"binding": "PUBLISHER", "service": "inspect-robots-review-publisher", "entrypoint": "GithubPublisher"}, {"binding": "RUNNER", "service": "inspect-robots-review-runner", "entrypoint": "CodeRunner"}],
  "durable_objects": {"bindings": [{"name": "LEDGER", "class_name": "ReviewLedger"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReviewLedger"]}],
  "workflows": [{"binding": "REVIEW", "name": "inspect-robots-review", "class_name": "ReviewWorkflow"}],
  "triggers": {"crons": ["*/10 * * * *"]},
  "observability": {"enabled": true},
  "limits": {"cpu_ms": 30000},
  "rules": [{"type": "Text", "globs": ["**/*.md"], "fallthrough": true}]
}
